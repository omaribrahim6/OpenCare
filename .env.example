# Copy to .env and fill in locally. Never commit real values.

# api lane
DATABASE_URL=
SESSION_SECRET=
CARD_TOKEN_PEPPER=
PUBLIC_BASE_URL=
PAIRING_PIN=

# ai lane
GEMINI_API_KEY=

# payments lane: Capital One Nessie (mock banking)
NESSIE_API_KEY=
NESSIE_FUND_ACCOUNT_ID=
NESSIE_PROVIDER_MERCHANT_ID=
NESSIE_PATIENT_ACCOUNT_ID=
NESSIE_PATIENT2_ACCOUNT_ID=
NESSIE_PATIENT3_ACCOUNT_ID=
NESSIE_DEMO_BILL_ID=

# payments lane: Solana devnet only
SOLANA_RPC_URL=https://api.devnet.solana.com
TREASURY_SECRET_KEY=
RECEIPT_LAMPORTS=
PROVIDER_SOLANA_WALLET=

# DATABASE_URL: Tiger Cloud pooled connection string (Vercel functions need the pooler).
# PUBLIC_BASE_URL: Vercel production URL; it is written into the CareCards.
# PAIRING_PIN: staff PIN for pairing kiosk, provider and reviewer devices.
# CARD_TOKEN_PEPPER: long random string (e.g. openssl rand -hex 32); changing it invalidates every card.
# TREASURY_SECRET_KEY: base58 devnet keypair, kept in an env var because Vercel has no key files.
